{
  "name": "platypicker",
  "version": "2.1.2",
  "description": "A searchable popover for native selects, with badges, long lists, a sheet on phones and 22 languages.",
  "keywords": [
    "select",
    "multiselect",
    "dropdown",
    "combobox",
    "searchable-select",
    "custom-element",
    "web-component",
    "popover",
    "vanilla-js",
    "no-dependencies"
  ],
  "private": false,
  "type": "module",
  "main": "src/platypicker.js",
  "types": "src/platypicker.d.ts",
  "style": "src/platypicker.css",
  "jsdelivr": "dist/platypicker.min.js",
  "unpkg": "dist/platypicker.min.js",
  "author": "Peter Petkov",
  "license": "MIT",
  "homepage": "https://peter-petkov.github.io/platypicker/",
  "bugs": {
    "url": "https://github.com/peter-petkov/platypicker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peter-petkov/platypicker.git"
  },
  "files": [
    "src",
    "dist"
  ],
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1",
    "puppeteer-core": "^25.18.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "check:firefox": "node tools/browser-check.mjs firefox",
    "check:webkit": "node tools/browser-check.mjs webkit",
    "check:types": "tsc -p types"
  }
}
